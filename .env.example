# Copy to .env and fill in as needed. Everything here is OPTIONAL for the Milestone 1 edge demo,
# which runs fully offline with the local espeak-ng TTS fallback.

# --- Cloud TTS (only if alerts.tts.provider = elevenlabs | google) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GOOGLE_TTS_API_KEY=

# --- Local LLM / vector store (Milestone 3) ---
OLLAMA_HOST=http://localhost:11434
QDRANT_URL=http://localhost:6333

# --- Backend datastores (Milestone 3, docker-compose) ---
POSTGRES_USER=fieldpilot
POSTGRES_PASSWORD=fieldpilot
POSTGRES_DB=fieldpilot
DATABASE_URL=postgresql+psycopg://fieldpilot:fieldpilot@localhost:5432/fieldpilot
REDIS_URL=redis://localhost:6379/0

# --- Event-driven platform (backend service) ---
# FIELDPILOT_EVENTS__BACKEND=postgres
# FIELDPILOT_EVENTS__DATABASE_URL=postgresql+psycopg://fieldpilot:fieldpilot@localhost:5432/fieldpilot
# FIELDPILOT_EVENTS__BUS_BACKEND=redis
# FIELDPILOT_EVENTS__REDIS_URL=redis://localhost:6379/0
# FIELDPILOT_TRIGGERS__DEDUP_WINDOW_S=45
# FIELDPILOT_TRIGGERS__RESOLVE_AFTER_S=90

# --- Streaming (Milestone 2) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Override any config.yaml value, e.g.:
# FIELDPILOT_APP__PERSPECTIVE=BOTH
# FIELDPILOT_ALERTS__TTS__PROVIDER=elevenlabs
