# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Env / secrets
.env

# Data & model artifacts (keep dirs via .gitkeep, ignore contents)
data/*.db
data/*.jsonl
data/tts_cache/
data/videos/*
data/blueprints/*
data/val_set/*
# alert snapshots the edge captures and the backend serves at /images/<id>.jpg — these are
# uploaded site imagery: unbounded in size and potentially identifying, so never committed.
data/alerts/
# photos workers upload with questions and manual hazard reports — user-submitted content
data/uploads/
# Public training corpora and generated merged datasets are downloaded locally. Keep only the
# acquisition/preparation code and provenance documentation in Git.
data/training_sources/
data/training/
data/training_captures/
data/site_datasets/
models/*.pt
models/*.tflite
models/*.onnx
# ultralytics drops auto-downloaded weights into the CWD — never commit those either
/*.pt
/*.onnx
models/*.yaml
models/finetuned/
# Ultralytics validation/training commands use this default when no project path is supplied.
/runs/
!**/.gitkeep

# Generated at runtime
fieldpilot/alerts/earcons/*.wav

# Local Claude settings
.claude/settings.local.json

# Node / Next.js
node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts

# Runtime logs
data/logs/

# OS
.DS_Store

# IDE
.idea/
.vscode/
*.iml
