# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Env / secrets
.env

# Data & model artifacts (keep dirs via .gitkeep, ignore contents)
data/*.db
data/*.jsonl
data/tts_cache/
data/videos/*
data/blueprints/*
data/val_set/*
# alert snapshots the edge captures and the backend serves at /images/<id>.jpg — these are
# uploaded site imagery: unbounded in size and potentially identifying, so never committed.
data/alerts/
models/*.pt
models/*.tflite
models/*.onnx
# ultralytics drops auto-downloaded weights into the CWD — never commit those either
/*.pt
/*.onnx
models/*.yaml
models/finetuned/
!**/.gitkeep

# Generated at runtime
fieldpilot/alerts/earcons/*.wav

# Local Claude settings
.claude/settings.local.json

# Node / Next.js
node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts

# Runtime logs
data/logs/

# OS
.DS_Store
